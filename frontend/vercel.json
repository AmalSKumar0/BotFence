{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|svg|webp|ico|xml|txt|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|vighnaghna.zip|BotFence.zip|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
