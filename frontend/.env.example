# Telegram Bot Credentials for Download Lead Notifications
# Create a bot via @BotFather on Telegram to obtain BOT_TOKEN
# Get your numeric CHAT_ID via @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
VITE_TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
VITE_TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Optional fallback keys (also supported):
# TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# TELEGRAM_CHAT_ID="your_telegram_chat_id"

# AI Studio / Gemini configuration (if needed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://bot-fence.vercel.app"
