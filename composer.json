{
    "name": "amalskumar/botfence",
    "description": "BotFence - Universal WordPress Anti-Spam & Automated CAPTCHA Plugin built by Amal S Kumar",
    "homepage": "https://bot-fence.vercel.app/",
    "authors": [
        {
            "name": "Amal S Kumar",
            "homepage": "https://amalskumar.dev"
        }
    ],
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BotFence\\": "botfence/includes/",
            "BotFence\\Integrations\\": "botfence/integrations/",
            "KL_Anti_Spam\\": "botfence/includes/",
            "KL_Anti_Spam\\Integrations\\": "botfence/integrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BotFence\\Tests\\": "botfence/tests/",
            "KL_Anti_Spam\\Tests\\": "botfence/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
