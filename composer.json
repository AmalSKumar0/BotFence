{
    "name": "amalskumar/vighnaghna",
    "description": "Vighnaghna - Lightweight, invisible anti-spam protection for WordPress forms. Built by Amal S Kumar",
    "homepage": "https://amalskumar.dev",
    "authors": [
        {
            "name": "Amal S Kumar",
            "homepage": "https://amalskumar.dev"
        }
    ],
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vighnaghna\\": "vighnaghna/includes/",
            "Vighnaghna\\Integrations\\": "vighnaghna/integrations/",
            "BotFence\\": "vighnaghna/includes/",
            "BotFence\\Integrations\\": "vighnaghna/integrations/",
            "KL_Anti_Spam\\": "vighnaghna/includes/",
            "KL_Anti_Spam\\Integrations\\": "vighnaghna/integrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vighnaghna\\Tests\\": "tests/",
            "BotFence\\Tests\\": "tests/",
            "KL_Anti_Spam\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
